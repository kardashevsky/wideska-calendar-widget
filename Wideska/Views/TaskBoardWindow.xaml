<Window x:Class="Wideska.Views.TaskBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Wideska Widget · Tasks" Width="1080" Height="620" MinWidth="760" MinHeight="430"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" FontFamily="Segoe UI" FontSize="13"
        Icon="/Wideska;component/Resources/Icons/Wideska.ico">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" CornerRadius="12" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="BoardCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></Style.Triggers>
        </Style>
        <DataTemplate x:Key="TaskColumnTemplate">
            <Border x:Name="DropZone" Margin="4" Padding="12" CornerRadius="12" Background="{DynamicResource WidgetGlass}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1" AllowDrop="True"
                    DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{Binding Title}" Foreground="{Binding Color}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid MinHeight="65" VerticalAlignment="Top">
                            <TextBlock Text="{DynamicResource Ui.Dragtaskshere}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="2,7">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Tasks.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Tasks}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Style="{StaticResource BoardCard}" PreviewMouseLeftButtonDown="OnTaskMouseDown"
                                            PreviewMouseMove="OnTaskMouseMove" ContextMenuOpening="OnTaskContextMenu">
                                        <Border.ContextMenu><ContextMenu/></Border.ContextMenu>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="⋯" Padding="0" Margin="3,0,0,0" FontSize="18" Click="OnTaskMenu" ToolTip="{DynamicResource Ui.Taskactions}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource WidgetOutline}" BorderThickness="1" CornerRadius="12" Padding="10">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="6,3,6,13" Background="Transparent" MouseLeftButtonDown="OnHeaderDown" MouseMove="OnHeaderMove" MouseLeftButtonUp="OnHeaderUp">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{DynamicResource Ui.Eisenhowermatrix}" FontSize="23" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource Ui.Backlogprioritizecomplete}" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel>
                <Button Grid.Column="1" Content="{DynamicResource Ui.Addtask}" Click="OnAddTask" Background="{DynamicResource AccentFill}" Padding="16,8" VerticalAlignment="Center"/>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="2.8*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                <ContentControl Content="{Binding Columns[0]}" ContentTemplate="{StaticResource TaskColumnTemplate}"/>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <ContentControl Content="{Binding Columns[1]}" ContentTemplate="{StaticResource TaskColumnTemplate}"/>
                    <ContentControl Grid.Column="1" Content="{Binding Columns[2]}" ContentTemplate="{StaticResource TaskColumnTemplate}"/>
                    <ContentControl Grid.Row="1" Content="{Binding Columns[3]}" ContentTemplate="{StaticResource TaskColumnTemplate}"/>
                    <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding Columns[4]}" ContentTemplate="{StaticResource TaskColumnTemplate}"/>
                </Grid>
                <ContentControl Grid.Column="2" Content="{Binding Columns[5]}" ContentTemplate="{StaticResource TaskColumnTemplate}"/>
            </Grid>
            <Grid Grid.Row="2" Margin="7,5,7,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Error}" Foreground="#FF7385" FontSize="11"/>
                <Button Grid.Column="1" Content="{DynamicResource Ui.Retry}" Click="OnRetry" Padding="8,2">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers>
                        <DataTrigger Binding="{Binding Error}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers></Style></Button.Style>
                </Button>
            </Grid>
            <Thumb Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="14" Height="14" Cursor="SizeNWSE" DragDelta="OnResize" DragCompleted="OnResizeCompleted">
                <Thumb.Template><ControlTemplate TargetType="Thumb"><Path Data="M 3,11 L 11,3 M 7,11 L 11,7" Stroke="{DynamicResource Muted}" StrokeThickness="1"/></ControlTemplate></Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
