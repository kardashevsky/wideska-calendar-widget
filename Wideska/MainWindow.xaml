<Window x:Class="Wideska.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Wideska.Controls"
        Title="Wideska" Icon="Resources/Icons/Wideska.ico" Width="480" Height="660" MinWidth="420" MinHeight="360"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="13"
        Loaded="OnLoaded" Closing="OnClosing" StateChanged="OnStateChanged">
    <Grid>
        <!-- The calendar is never visible until the initial account check has completed. -->
        <Border x:Name="WidgetRoot" IsEnabled="{Binding IsCalendarEnabled}" CornerRadius="{Binding WidgetCornerRadius}" Background="{DynamicResource WidgetGlass}" Padding="24,18,24,14"
                Visibility="{Binding ShowWidget, Converter={StaticResource VisibleIf}}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Grid.Row="1" Margin="0,0,0,18" Background="Transparent" MouseLeftButtonDown="OnDrag">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Period}" FontSize="42" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                    </Viewbox>
                    <DockPanel Grid.Row="1" Margin="0,0,0,12" Visibility="{Binding IsSingleDay, Converter={StaticResource VisibleIf}}">
                        <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Padding="14,0,0,0" Margin="12,0,0,0" ToolTip="{Binding CalendarTimeZoneLabel}">
                            <TextBlock Text="{Binding ClockText}" FontFamily="Consolas" FontSize="23" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding DayHeading}" FontSize="17" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style><Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsWeekendHeading}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Weekend}"/></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                    <DockPanel Grid.Row="2">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Today" Command="{Binding TodayCommand}" FontSize="11" Padding="8,4"/>
                            <Button Content="‹" Command="{Binding PreviousCommand}" FontSize="18" Padding="9,1" ToolTip="Previous period"/>
                            <Button Content="›" Command="{Binding NextCommand}" FontSize="18" Padding="9,1" ToolTip="Next period"/>
                        </StackPanel>
                        <ComboBox HorizontalAlignment="Left" ItemsSource="{Binding Views}" DisplayMemberPath="Title" SelectedValuePath="Value" SelectedValue="{Binding View}" ToolTip="Calendar view" AutomationProperties.Name="Calendar view" FontSize="11"/>
                    </DockPanel>
                </Grid>
                <Grid x:Name="CalendarContent" Grid.Row="2">
                    <Grid Visibility="{Binding IsMonth, Converter={StaticResource VisibleIf}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <UniformGrid Columns="7" Margin="0,0,0,6" TextElement.FontSize="10">
                            <TextBlock Text="MON" HorizontalAlignment="Center" Style="{StaticResource Caption}"/>
                            <TextBlock Text="TUE" HorizontalAlignment="Center" Style="{StaticResource Caption}"/>
                            <TextBlock Text="WED" HorizontalAlignment="Center" Style="{StaticResource Caption}"/>
                            <TextBlock Text="THU" HorizontalAlignment="Center" Style="{StaticResource Caption}"/>
                            <TextBlock Text="FRI" HorizontalAlignment="Center" Style="{StaticResource Caption}"/>
                            <TextBlock Text="SAT" HorizontalAlignment="Center" Style="{StaticResource Caption}" Foreground="{DynamicResource Weekend}"/>
                            <TextBlock Text="SUN" HorizontalAlignment="Center" Style="{StaticResource Caption}" Foreground="{DynamicResource Weekend}"/>
                        </UniformGrid>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Days}" ItemTemplate="{StaticResource MonthDayTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                    <ScrollViewer Visibility="{Binding IsDays, Converter={StaticResource VisibleIf}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <controls:DayTimeline x:Name="Timeline" EventCommand="{Binding OpenEventCommand}" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource TimelineHeight}}" Days="{Binding Days}" CurrentTime="{Binding CurrentTime}" TimeZoneId="{Binding CalendarTimeZoneId}" Foreground="{DynamicResource Text}" GridBrush="{DynamicResource TimelineGrid}" SurfaceBrush="{DynamicResource TimelineCard}" MutedBrush="{DynamicResource TimelineMuted}" AxisBrush="{DynamicResource TimelineAxis}" AccentBrush="{DynamicResource Accent}" NowBrush="{DynamicResource TimelineNow}" WeekendBrush="{DynamicResource Weekend}" MinWidth="{Binding Columns, Converter={StaticResource TimelineWidth}}"/>
                    </ScrollViewer>
                    <Grid Visibility="{Binding IsYear, Converter={StaticResource VisibleIf}}">
                        <Viewbox Stretch="Uniform" MaxWidth="1440" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <ItemsControl x:Name="YearCalendar" ItemsSource="{Binding Quarters}" Width="1200">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" Rows="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Margin="6" Padding="16" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14">
                                    <StackPanel>
                                        <DockPanel Margin="2,0,2,12">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Range}" Style="{StaticResource Caption}" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <Border Background="{DynamicResource Panel}" CornerRadius="9" Padding="10,5" HorizontalAlignment="Left"><TextBlock Text="{Binding Label}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="18"/></Border>
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Months}" ItemTemplate="{StaticResource YearMonthTemplate}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Viewbox>
                    </Grid>
                </Grid>
                <Grid x:Name="SyncStatus" Grid.Row="3" Height="16" Margin="0,8,0,0" Style="{StaticResource QuietSyncStatus}">
                    <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                            <DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <Grid Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Style="{StaticResource SyncSpinner}" Visibility="{Binding Busy, Converter={StaticResource VisibleIf}}" AutomationProperties.Name="Synchronizing calendars">
                        <Grid.RenderTransform><RotateTransform/></Grid.RenderTransform>
                        <Path Data="M 7,1 A 6,6 0 1 1 1,7" Stroke="{DynamicResource Accent}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>
                </Grid>
                <Border Grid.RowSpan="4" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="18" Padding="20" HorizontalAlignment="Right" Width="340" Visibility="{Binding SettingsOpen, Converter={StaticResource VisibleIf}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <DockPanel><Button DockPanel.Dock="Right" Content="Done" Command="{Binding SaveSettingsCommand}"/><TextBlock Text="Make it yours" FontSize="22" FontWeight="Light"/></DockPanel>
                        <TextBlock Text="APPEARANCE" Style="{StaticResource Caption}" Margin="0,22,0,4"/>
                        <CheckBox Content="Light text for dark wallpapers" IsChecked="{Binding DarkTheme}"/>
                        <TextBlock Text="Background tint" Margin="0,10,0,0"/>
                        <Slider Minimum="0" Maximum="0.85" Value="{Binding BackgroundOpacity}" Margin="0,12,0,3" AutomationProperties.Name="Background tint opacity"/>
                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="More contrast" Style="{StaticResource Caption}" HorizontalAlignment="Right"/><TextBlock Text="Fully transparent" Style="{StaticResource Caption}"/></DockPanel>
                        <TextBlock Text="Only the background changes. Text stays crisp." Style="{StaticResource Caption}" Margin="0,8,0,8"/>
                        <TextBlock Text="ON YOUR DESKTOP" Style="{StaticResource Caption}" Margin="0,18,0,4"/>
                                                <TextBlock Text="Attached to the desktop, below application windows." Style="{StaticResource Caption}"/>
                        <CheckBox Content="Lock position and size" IsChecked="{Binding GeometryLocked}"/>
                        <Button Content="{Binding DesktopSizeActionLabel}" Command="{Binding FitDesktopCommand}" IsEnabled="{Binding CanEditGeometry}"/>
                        <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}"/>
                        <TextBlock Text="TIME ZONE" Style="{StaticResource Caption}" Margin="0,18,0,4"/>
                        <ComboBox ItemsSource="{Binding Calendars}" DisplayMemberPath="Calendar.Name" SelectedValuePath="Calendar.Id" SelectedValue="{Binding TimeZoneCalendarId}" ToolTip="Use the selected calendar time zone"/>
                        <TextBlock Text="{Binding CalendarTimeZoneLabel}" Style="{StaticResource Caption}"/>
                        <TextBlock Text="CALENDARS" Style="{StaticResource Caption}" Margin="0,18,0,4"/>
                        <ItemsControl ItemsSource="{Binding Calendars}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Visible}"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{Binding Calendar.Color}" Margin="0,0,8,0"/><TextBlock Text="{Binding Calendar.Name}" MaxWidth="240"/></StackPanel></CheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock Text="Syncs automatically every minute." Style="{StaticResource Caption}" Margin="0,16,0,8"/>
                        <Button Content="Disconnect Google account" Command="{Binding DisconnectCommand}" HorizontalAlignment="Left"/>
                        <TextBlock Text="Drag the month heading to move. Drag any edge or corner to resize. Find the widget again in the system tray." Style="{StaticResource Caption}" Margin="0,12"/>
                    </StackPanel></ScrollViewer>
                </Border>
            </Grid>
        </Border>
        <!-- First-run connection and returning-session check replace the entire calendar. -->
        <Border x:Name="AuthorizationRoot" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="24" Padding="28,22" Margin="8" MaxWidth="480"
                Visibility="{Binding ShowAuthorization, Converter={StaticResource VisibleIf}}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Background="Transparent" MouseLeftButtonDown="OnDrag">

                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                    <StackPanel>

                        <TextBlock Text="Your day.&#x0A;Part of your desktop." FontSize="30" FontWeight="Light" LineHeight="36"/>
                        <TextBlock Text="Connect Google Calendar to bring your schedule onto your wallpaper." Foreground="{DynamicResource Muted}" Margin="0,12,0,18" FontSize="13"/>
                        <StackPanel x:Name="ConnectionForm">
                            <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding IsInitialized}" Value="False"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <Button Content="Import Google OAuth file" Click="OnImportCredentials" BorderBrush="{DynamicResource Line}" Padding="12,10"/>
                            <TextBlock Text="{Binding CredentialStatus}" Style="{StaticResource Caption}" Margin="2,7,0,14"/>
                            <Button Content="Continue with Google  →" Style="{StaticResource PrimaryButton}" Command="{Binding ConnectCommand}" IsEnabled="{Binding HasCredentials}"/>
                            <TextBlock Text="Read-only access · Your events stay on this PC" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                            <Expander Header="First time? Set up Google connection" IsExpanded="True">
                                <StackPanel Margin="4,12,0,0">
                                    <TextBlock Text="1   Enable Google Calendar API in your Cloud project." FontSize="12" Margin="0,0,0,10"/>
                                    <TextBlock Text="2   In Google Auth platform, configure consent and add your email as a test user. Create a Desktop app client and download its JSON file." FontSize="12" Margin="0,0,0,10"/>
                                    <TextBlock Text="3   Import that file above, then continue with Google and allow calendar access in your browser." FontSize="12"/>
                                    <WrapPanel Margin="0,8,0,0"><Button Content="Open Google Cloud ↗" Click="OnOpenGoogleCloud" FontSize="11" Foreground="{DynamicResource Accent}"/><Button Content="Setup guide ↗" Click="OnOpenGoogleGuide" FontSize="11" Foreground="{DynamicResource Accent}"/></WrapPanel>
                                </StackPanel>
                            </Expander>
                            <Expander Header="Enter OAuth credentials manually">
                                <StackPanel Margin="0,10,0,0"><TextBlock Text="Desktop OAuth client ID" FontSize="12"/><TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Desktop OAuth client secret" FontSize="12"/><TextBox Text="{Binding ClientSecret, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            </Expander>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <ProgressBar Height="2" IsIndeterminate="True" Visibility="{Binding Busy, Converter={StaticResource VisibleIf}}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Visibility="{Binding CanEditGeometry, Converter={StaticResource VisibleIf}}">
            <Thumb Tag="N" Height="6" VerticalAlignment="Top" Margin="14,0" Cursor="SizeNS" DragDelta="OnResize"/>
            <Thumb Tag="S" Height="6" VerticalAlignment="Bottom" Margin="14,0" Cursor="SizeNS" DragDelta="OnResize"/>
            <Thumb Tag="W" Width="6" HorizontalAlignment="Left" Margin="0,14" Cursor="SizeWE" DragDelta="OnResize"/>
            <Thumb Tag="E" Width="6" HorizontalAlignment="Right" Margin="0,14" Cursor="SizeWE" DragDelta="OnResize"/>
            <Thumb Tag="NW" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" DragDelta="OnResize"/>
            <Thumb Tag="NE" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" DragDelta="OnResize"/>
            <Thumb Tag="SW" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" DragDelta="OnResize"/>
        </Grid>
        <Thumb Tag="SE" x:Name="ResizeGrip" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="OnResize" Margin="0,0,4,4" Visibility="{Binding CanEditGeometry, Converter={StaticResource VisibleIf}}" ToolTip="Drag to resize">
            <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="#01000000"><Path Data="M 8,18 L 18,8 M 13,18 L 18,13" Stroke="{DynamicResource Muted}" StrokeThickness="1" Opacity="0.6"/></Grid></ControlTemplate></Thumb.Template>
        </Thumb>
        <Border x:Name="EventDetailsOverlay" Background="#99080C10" CornerRadius="{Binding WidgetCornerRadius}" Padding="24" Visibility="{Binding IsEventOpen, Converter={StaticResource VisibleIf}}">
            <Grid>
                <Button Command="{Binding CloseEventCommand}" Background="Transparent" Padding="0" Margin="0" BorderThickness="0" Focusable="False" ToolTip="Back to calendar">
                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"/></ControlTemplate></Button.Template>
                </Button>
                <Border DataContext="{Binding SelectedEvent}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="18" Padding="22" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Ellipse Width="8" Height="8" Fill="{Binding Color}" Margin="0,0,8,0"/><TextBlock Text="{Binding CalendarName}" Style="{StaticResource Caption}"/></StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="420">
                            <StackPanel>
                                <TextBlock Text="{Binding DateLabel}" FontSize="14" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Time}" FontSize="16" FontWeight="Medium"/>
                                <TextBlock Text="{Binding TimeZoneLabel}" Style="{StaticResource Caption}" Margin="0,5,0,16"/>
                                <StackPanel Visibility="{Binding HasLocation, Converter={StaticResource VisibleIf}}" Margin="0,0,0,16">
                                    <TextBlock Text="LOCATION" Style="{StaticResource Caption}" Margin="0,0,0,6"/><TextBlock Text="{Binding Location}" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding HasDescription, Converter={StaticResource VisibleIf}}">
                                    <TextBlock Text="DESCRIPTION" Style="{StaticResource Caption}" Margin="0,0,0,6"/><TextBlock Text="{Binding Description}" FontSize="13" LineHeight="20"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <Button Grid.Row="2" Content="Back to calendar" HorizontalAlignment="Right" Command="{Binding DataContext.CloseEventCommand, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{DynamicResource Line}" Margin="0,18,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
