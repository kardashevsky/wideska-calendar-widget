<Window x:Class="Wideska.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wideska" Icon="Resources/Icons/Wideska.ico" Width="480" Height="660" MinWidth="420" MinHeight="360"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="13"
        Loaded="OnLoaded" Closing="OnClosing" StateChanged="OnStateChanged">
    <Grid>
        <!-- The calendar is never visible until the initial account check has completed. -->
        <Border x:Name="WidgetRoot" CornerRadius="24" Background="{DynamicResource WidgetGlass}" Padding="24,18,24,14"
                Visibility="{Binding ShowWidget, Converter={StaticResource VisibleIf}}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Background="Transparent" MouseLeftButtonDown="OnDrag" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Resources/Icons/Wideska.png" Width="20" Height="20" Margin="0,0,8,0"/>
                        <TextBlock Text="W I D E S K A" Style="{StaticResource Caption}" FontSize="10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Style="{StaticResource QuietControls}">
                        <Button Style="{StaticResource IconButton}" Content="&#xE895;" Command="{Binding RefreshCommand}" ToolTip="Sync calendars" AutomationProperties.Name="Sync calendars"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE713;" Command="{Binding SettingsCommand}" ToolTip="Widget settings" AutomationProperties.Name="Widget settings"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="OnHide" ToolTip="Hide to tray" AutomationProperties.Name="Hide to tray"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,0,0,18" Background="Transparent" MouseLeftButtonDown="OnDrag">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="{Binding Period}" FontSize="30" FontWeight="Light" Margin="0,0,0,8"/>
                    <DockPanel Grid.Row="1">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Today" Command="{Binding TodayCommand}" FontSize="11" Padding="8,4"/>
                            <Button Content="‹" Command="{Binding PreviousCommand}" FontSize="18" Padding="9,1" ToolTip="Previous period"/>
                            <Button Content="›" Command="{Binding NextCommand}" FontSize="18" Padding="9,1" ToolTip="Next period"/>
                        </StackPanel>
                        <ComboBox HorizontalAlignment="Left" ItemsSource="{Binding Views}" DisplayMemberPath="Title" SelectedValuePath="Value" SelectedValue="{Binding View}" ToolTip="Calendar view" AutomationProperties.Name="Calendar view" FontSize="11"/>
                    </DockPanel>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid Visibility="{Binding IsMonth, Converter={StaticResource VisibleIf}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <UniformGrid Columns="7" Margin="0,0,0,6" TextElement.FontSize="10">
                            <TextBlock Text="MON" HorizontalAlignment="Center" Style="{StaticResource Caption}"/>
                            <TextBlock Text="TUE" HorizontalAlignment="Center" Style="{StaticResource Caption}"/>
                            <TextBlock Text="WED" HorizontalAlignment="Center" Style="{StaticResource Caption}"/>
                            <TextBlock Text="THU" HorizontalAlignment="Center" Style="{StaticResource Caption}"/>
                            <TextBlock Text="FRI" HorizontalAlignment="Center" Style="{StaticResource Caption}"/>
                            <TextBlock Text="SAT" HorizontalAlignment="Center" Style="{StaticResource Caption}"/>
                            <TextBlock Text="SUN" HorizontalAlignment="Center" Style="{StaticResource Caption}"/>
                        </UniformGrid>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Days}" ItemTemplate="{StaticResource MonthDayTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                    <ScrollViewer Visibility="{Binding IsDays, Converter={StaticResource VisibleIf}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Days}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border MinWidth="116" Padding="4,0,8,0">
                                    <StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding Events}" ItemTemplate="{StaticResource EventTemplate}"/><TextBlock x:Name="EmptyDay" Text="A little room to breathe." Foreground="{DynamicResource Muted}" FontSize="11" Visibility="Collapsed" Margin="0,10"/></StackPanel>
                                </Border>
                                <DataTemplate.Triggers><DataTrigger Binding="{Binding Events.Count}" Value="0"><Setter TargetName="EmptyDay" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <ScrollViewer Visibility="{Binding IsYear, Converter={StaticResource VisibleIf}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Months}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Width="205" Margin="0,0,12,18" Padding="4"><StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="Medium" FontSize="14" Margin="0,0,0,10"/>
                                    <UniformGrid Columns="7" Margin="0,0,0,5"><TextBlock Text="M" Style="{StaticResource Caption}"/><TextBlock Text="T" Style="{StaticResource Caption}"/><TextBlock Text="W" Style="{StaticResource Caption}"/><TextBlock Text="T" Style="{StaticResource Caption}"/><TextBlock Text="F" Style="{StaticResource Caption}"/><TextBlock Text="S" Style="{StaticResource Caption}"/><TextBlock Text="S" Style="{StaticResource Caption}"/></UniformGrid>
                                    <ItemsControl ItemsSource="{Binding Days}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Button x:Name="MiniDay" Content="{Binding Number}" Padding="1,4" Margin="0" FontSize="11" BorderBrush="{DynamicResource Line}" Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Date}" ToolTip="{Binding Events.Count, StringFormat={}{0} events}"/>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding InMonth}" Value="False"><Setter TargetName="MiniDay" Property="Opacity" Value="0.25"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Today}" Value="True"><Setter TargetName="MiniDay" Property="Background" Value="{DynamicResource AccentFill}"/><Setter TargetName="MiniDay" Property="Foreground" Value="White"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Events.Count}" Value="0"><Setter TargetName="MiniDay" Property="BorderBrush" Value="Transparent"/></DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel></Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
                <StackPanel Grid.Row="3" Margin="0,8,0,0" Style="{StaticResource QuietControls}">
                    <ProgressBar Height="2" IsIndeterminate="True" Visibility="{Binding Busy, Converter={StaticResource VisibleIf}}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" FontSize="10" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Status}"/>
                </StackPanel>
                <Border Grid.RowSpan="4" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="18" Padding="20" HorizontalAlignment="Right" Width="340" Visibility="{Binding SettingsOpen, Converter={StaticResource VisibleIf}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <DockPanel><Button DockPanel.Dock="Right" Content="Done" Command="{Binding SaveSettingsCommand}"/><TextBlock Text="Make it yours" FontSize="22" FontWeight="Light"/></DockPanel>
                        <TextBlock Text="APPEARANCE" Style="{StaticResource Caption}" Margin="0,22,0,4"/>
                        <CheckBox Content="Light text for dark wallpapers" IsChecked="{Binding DarkTheme}"/>
                        <TextBlock Text="Background tint" Margin="0,10,0,0"/>
                        <Slider Minimum="0" Maximum="0.85" Value="{Binding BackgroundOpacity}" Margin="0,12,0,3" AutomationProperties.Name="Background tint opacity"/>
                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="More contrast" Style="{StaticResource Caption}" HorizontalAlignment="Right"/><TextBlock Text="Fully transparent" Style="{StaticResource Caption}"/></DockPanel>
                        <TextBlock Text="Only the background changes. Text stays crisp." Style="{StaticResource Caption}" Margin="0,8,0,8"/>
                        <TextBlock Text="ON YOUR DESKTOP" Style="{StaticResource Caption}" Margin="0,18,0,4"/>
                        <ComboBox ItemsSource="{Binding Behaviors}" DisplayMemberPath="Title" SelectedValuePath="Value" SelectedValue="{Binding Behavior}"/>
                        <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}"/>
                        <TextBlock Text="CALENDARS" Style="{StaticResource Caption}" Margin="0,18,0,4"/>
                        <ItemsControl ItemsSource="{Binding Calendars}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Visible}"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{Binding Calendar.Color}" Margin="0,0,8,0"/><TextBlock Text="{Binding Calendar.Name}" MaxWidth="240"/></StackPanel></CheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock Text="Sync interval, minutes (1–60)" Margin="0,16,0,0"/><TextBox Text="{Binding SyncMinutes}"/>
                        <Button Content="Disconnect Google account" Command="{Binding DisconnectCommand}" HorizontalAlignment="Left"/>
                        <TextBlock Text="Drag the month heading to move. Use the corner grip to resize. Find the widget again in the system tray." Style="{StaticResource Caption}" Margin="0,12"/>
                        <Button Content="Quit widget" Click="OnQuit" HorizontalAlignment="Left" Foreground="{DynamicResource Muted}"/>
                    </StackPanel></ScrollViewer>
                </Border>
            </Grid>
        </Border>
        <!-- First-run connection and returning-session check replace the entire calendar. -->
        <Border x:Name="AuthorizationRoot" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="24" Padding="28,22" Margin="8" MaxWidth="480"
                Visibility="{Binding ShowAuthorization, Converter={StaticResource VisibleIf}}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Background="Transparent" MouseLeftButtonDown="OnDrag">
                    <Button DockPanel.Dock="Right" Content="&#xE8BB;" Style="{StaticResource IconButton}" Click="OnQuit" ToolTip="Quit Wideska" AutomationProperties.Name="Quit Wideska"/>
                    <TextBlock Text="W I D E S K A" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                    <StackPanel>
                        <Image Source="Resources/Icons/Wideska.png" Width="52" Height="52" HorizontalAlignment="Left" Margin="0,0,0,18"/>
                        <TextBlock Text="Your day.&#x0A;Part of your desktop." FontSize="30" FontWeight="Light" LineHeight="36"/>
                        <TextBlock Text="Connect Google Calendar to bring your schedule onto your wallpaper." Foreground="{DynamicResource Muted}" Margin="0,12,0,18" FontSize="13"/>
                        <StackPanel x:Name="ConnectionForm">
                            <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding IsInitialized}" Value="False"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <Button Content="Import Google OAuth file" Click="OnImportCredentials" BorderBrush="{DynamicResource Line}" Padding="12,10"/>
                            <TextBlock Text="{Binding CredentialStatus}" Style="{StaticResource Caption}" Margin="2,7,0,14"/>
                            <Button Content="Continue with Google  →" Style="{StaticResource PrimaryButton}" Command="{Binding ConnectCommand}" IsEnabled="{Binding HasCredentials}"/>
                            <TextBlock Text="Read-only access · Your events stay on this PC" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                            <Expander Header="First time? Set up Google connection" IsExpanded="True">
                                <StackPanel Margin="4,12,0,0">
                                    <TextBlock Text="1   Enable Google Calendar API in your Cloud project." FontSize="12" Margin="0,0,0,10"/>
                                    <TextBlock Text="2   In Google Auth platform, configure consent and add your email as a test user. Create a Desktop app client and download its JSON file." FontSize="12" Margin="0,0,0,10"/>
                                    <TextBlock Text="3   Import that file above, then continue with Google and allow calendar access in your browser." FontSize="12"/>
                                    <WrapPanel Margin="0,8,0,0"><Button Content="Open Google Cloud ↗" Click="OnOpenGoogleCloud" FontSize="11" Foreground="{DynamicResource Accent}"/><Button Content="Setup guide ↗" Click="OnOpenGoogleGuide" FontSize="11" Foreground="{DynamicResource Accent}"/></WrapPanel>
                                </StackPanel>
                            </Expander>
                            <Expander Header="Enter OAuth credentials manually">
                                <StackPanel Margin="0,10,0,0"><TextBlock Text="Desktop OAuth client ID" FontSize="12"/><TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Desktop OAuth client secret" FontSize="12"/><TextBox Text="{Binding ClientSecret, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            </Expander>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <ProgressBar Height="2" IsIndeterminate="True" Visibility="{Binding Busy, Converter={StaticResource VisibleIf}}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"/>
                </StackPanel>
            </Grid>
        </Border>
        <Thumb x:Name="ResizeGrip" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="OnResize" Margin="0,0,4,4" Visibility="{Binding ShowWidget, Converter={StaticResource VisibleIf}}" ToolTip="Drag to resize">
            <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="#01000000"><Path Data="M 8,18 L 18,8 M 13,18 L 18,13" Stroke="{DynamicResource Muted}" StrokeThickness="1" Opacity="0.6"/></Grid></ControlTemplate></Thumb.Template>
        </Thumb>
    </Grid>
</Window>
