<Window x:Class="Wideska.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Wideska.Controls"
        xmlns:infrastructure="clr-namespace:Wideska.Infrastructure"
        Title="Wideska" Icon="Resources/Icons/Wideska.ico" Width="480" Height="660" MinWidth="420" MinHeight="360"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="13"
        Loaded="OnLoaded" Closing="OnClosing" StateChanged="OnStateChanged">
    <Grid>
        <!-- The calendar is never visible until the initial account check has completed. -->
        <Border x:Name="WidgetRoot" IsEnabled="{Binding IsCalendarEnabled}" CornerRadius="{Binding WidgetCornerRadius}" Background="{DynamicResource WidgetGlass}" BorderBrush="{DynamicResource WidgetOutline}" BorderThickness="1" Padding="0"
                Visibility="{Binding ShowWidget, Converter={StaticResource VisibleIf}}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid x:Name="CalendarHeader" Grid.Row="1" Margin="12,7" Background="Transparent" MouseLeftButtonDown="OnDrag" SizeChanged="OnHeaderSizeChanged">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock SizeChanged="OnHeaderSizeChanged" x:Name="HeaderPeriod" Text="{Binding Period}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="NoWrap" Margin="0,3"/>
                    <StackPanel x:Name="HeaderNavigation" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" SizeChanged="OnHeaderSizeChanged">
                        <Button Click="OnShowToday" x:Name="TodayButton" Visibility="{Binding ShouldShowToday, Converter={StaticResource VisibleIf}}" Content="{DynamicResource Ui.Today}" Command="{Binding TodayCommand}" Cursor="Hand" Background="{DynamicResource AccentFill}" Foreground="White" FontSize="12" FontWeight="SemiBold" MinWidth="116" Height="36" Padding="12,4" Margin="0,0,8,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Button Click="OnNavigatePeriod" x:Name="PreviousPeriodButton" Style="{StaticResource NavigationArrowButton}" Tag="M 8,0 L 2,6 L 8,12" Command="{Binding PreviousCommand}" ToolTip="{DynamicResource Ui.Previousperiod}" AutomationProperties.Name="{DynamicResource Ui.Previousperiod}" Margin="0,0,4,0"/>
                        <ComboBox x:Name="CalendarViewSelector" Width="114" Height="40" Margin="0" Cursor="Hand" ItemsSource="{Binding Views}" DisplayMemberPath="Title" SelectedValuePath="Value" SelectedValue="{Binding View}" ToolTip="{DynamicResource Ui.Calendarview}" AutomationProperties.Name="{DynamicResource Ui.Calendarview}" FontSize="12"/>
                        <Button Click="OnNavigatePeriod" x:Name="NextPeriodButton" Style="{StaticResource NavigationArrowButton}" Tag="M 2,0 L 8,6 L 2,12" Command="{Binding NextCommand}" ToolTip="{DynamicResource Ui.Nextperiod}" AutomationProperties.Name="{DynamicResource Ui.Nextperiod}" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
                <Grid x:Name="CalendarContent" Grid.Row="2" ClipToBounds="True">
                    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                    <Grid Visibility="{Binding IsMonth, Converter={StaticResource VisibleIf}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <UniformGrid Columns="7" Margin="0,0,0,6" TextElement.FontSize="10">
                            <TextBlock Text="{DynamicResource Ui.MON}" HorizontalAlignment="Center" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{DynamicResource Ui.TUE}" HorizontalAlignment="Center" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{DynamicResource Ui.WED}" HorizontalAlignment="Center" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{DynamicResource Ui.THU}" HorizontalAlignment="Center" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{DynamicResource Ui.FRI}" HorizontalAlignment="Center" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{DynamicResource Ui.SAT}" HorizontalAlignment="Center" Style="{StaticResource Caption}" Foreground="{DynamicResource Weekend}"/>
                            <TextBlock Text="{DynamicResource Ui.SUN}" HorizontalAlignment="Center" Style="{StaticResource Caption}" Foreground="{DynamicResource Weekend}"/>
                        </UniformGrid>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Days}" ItemTemplate="{StaticResource MonthDayTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                    <ScrollViewer Style="{StaticResource CalendarScrollViewer}" ClipToBounds="True" Visibility="{Binding IsDays, Converter={StaticResource VisibleIf}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <controls:DayTimeline x:Name="Timeline" ClockText="{Binding ClockText}" EventCommand="{Binding OpenEventCommand}" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource TimelineHeight}}" Days="{Binding Days}" CurrentTime="{Binding CurrentTime}" TimeZoneId="{Binding CalendarTimeZoneId}" Foreground="{DynamicResource Text}" GridBrush="{DynamicResource TimelineGrid}" SurfaceBrush="{DynamicResource TimelineCard}" MutedBrush="{DynamicResource TimelineMuted}" AxisBrush="{DynamicResource TimelineAxis}" AccentBrush="{DynamicResource Accent}" TodayHeaderBrush="{DynamicResource TimelineTodayHeader}" PastDayShade="{DynamicResource PastDayShade}" NowBrush="{DynamicResource TimelineNow}" WeekendBrush="{DynamicResource Weekend}" MinWidth="{Binding Columns, Converter={StaticResource TimelineWidth}}"/>
                    </ScrollViewer>
                    <Grid Visibility="{Binding IsYear, Converter={StaticResource VisibleIf}}">
                        <Viewbox Stretch="Uniform" MaxWidth="1440" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <ItemsControl x:Name="YearCalendar" ItemsSource="{Binding Quarters}" Width="1200">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" Rows="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Margin="6" Padding="16" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14">
                                    <StackPanel>
                                        <DockPanel Margin="2,0,2,12">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Range}" Style="{StaticResource Caption}" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <Border Background="{DynamicResource Panel}" CornerRadius="9" Padding="10,5" HorizontalAlignment="Left"><TextBlock Text="{Binding Label}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="18"/></Border>
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Months}" ItemTemplate="{StaticResource YearMonthTemplate}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Viewbox>
                    </Grid>
                </Grid>
                <Canvas x:Name="CalendarTransitionSurface" Grid.Row="2" IsHitTestVisible="False" ClipToBounds="True">
                    <Image x:Name="IncomingCalendar" Canvas.Left="0" Canvas.Top="0" Width="{Binding ActualWidth, ElementName=CalendarContent}" Height="{Binding ActualHeight, ElementName=CalendarContent}" Visibility="Collapsed" Stretch="Fill"><Image.RenderTransform><TranslateTransform/></Image.RenderTransform></Image>
                    <Image x:Name="OutgoingCalendar" Canvas.Left="0" Canvas.Top="0" Width="{Binding ActualWidth, ElementName=CalendarContent}" Height="{Binding ActualHeight, ElementName=CalendarContent}" Visibility="Collapsed" Stretch="Fill"><Image.RenderTransform><TranslateTransform/></Image.RenderTransform></Image>
                </Canvas>
                <Border infrastructure:AppearanceAnimation.Enabled="True" Grid.RowSpan="4" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="18" Padding="20" HorizontalAlignment="Right" Width="340" Visibility="{Binding SettingsOpen, Converter={StaticResource VisibleIf}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource Ui.Done}" Command="{Binding SaveSettingsCommand}"/><TextBlock Text="{DynamicResource Ui.Makeityours}" FontSize="22" FontWeight="Light"/></DockPanel>
                        <TextBlock Text="{DynamicResource Ui.Language}" Style="{StaticResource Caption}" Margin="0,16,0,4"/>
                        <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Title" SelectedValuePath="Value" SelectedValue="{Binding Language}" ToolTip="{DynamicResource Ui.Language}"/>
                        <TextBlock Text="{DynamicResource Ui.APPEARANCE}" Style="{StaticResource Caption}" Margin="0,22,0,4"/>
                        <CheckBox Content="{DynamicResource Ui.Lighttextfordarkwallpapers}" IsChecked="{Binding DarkTheme}"/>
                        <TextBlock Text="{DynamicResource Ui.Backgroundtint}" Margin="0,10,0,0"/>
                        <Slider Minimum="0" Maximum="0.85" Value="{Binding BackgroundOpacity}" Margin="0,12,0,3" AutomationProperties.Name="{DynamicResource Ui.Backgroundtintopacity}"/>
                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{DynamicResource Ui.Morecontrast}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/><TextBlock Text="{DynamicResource Ui.Fullytransparent}" Style="{StaticResource Caption}"/></DockPanel>
                        <TextBlock Text="{DynamicResource Ui.OnlythebackgroundchangesTextstayscrisp}" Style="{StaticResource Caption}" Margin="0,8,0,8"/>
                        <TextBlock Text="{DynamicResource Ui.ONYOURDESKTOP}" Style="{StaticResource Caption}" Margin="0,18,0,4"/>
                                                <TextBlock Text="{DynamicResource Ui.Attachedtothedesktopbelowapplicationwindows}" Style="{StaticResource Caption}"/>
                        <CheckBox Content="{DynamicResource Ui.Lockpositionandsize}" IsChecked="{Binding GeometryLocked}"/>
                        <Button Content="{Binding DesktopSizeActionLabel}" Command="{Binding FitDesktopCommand}" IsEnabled="{Binding CanEditGeometry}"/>
                        <CheckBox Content="{DynamicResource Ui.StartwithWindows}" IsChecked="{Binding StartWithWindows}"/>
                        <TextBlock Text="{DynamicResource Ui.TIMEZONE}" Style="{StaticResource Caption}" Margin="0,18,0,4"/>
                        <ComboBox ItemsSource="{Binding Calendars}" DisplayMemberPath="Calendar.Name" SelectedValuePath="Calendar.Id" SelectedValue="{Binding TimeZoneCalendarId}" ToolTip="{DynamicResource Ui.Usetheselectedcalendartimezone}"/>
                        <TextBlock Text="{Binding CalendarTimeZoneLabel}" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{DynamicResource Ui.CALENDARS}" Style="{StaticResource Caption}" Margin="0,18,0,4"/>
                        <ItemsControl ItemsSource="{Binding Calendars}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Visible}"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{Binding Calendar.Color}" Margin="0,0,8,0"/><TextBlock Text="{Binding Calendar.Name}" MaxWidth="240"/></StackPanel></CheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <Button Content="{DynamicResource Ui.DisconnectGoogleaccount}" Command="{Binding DisconnectCommand}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{DynamicResource Ui.DragthemonthheadingtomoveDraganyedgeorcornertoresizeFindthewidgetagaininthesystemtray}" Style="{StaticResource Caption}" Margin="0,12"/>
                    </StackPanel></ScrollViewer>
                </Border>
            </Grid>
        </Border>
        <!-- First-run connection and returning-session check replace the entire calendar. -->
        <Border x:Name="AuthorizationRoot" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="24" Padding="28,22" Margin="8" MaxWidth="480"
                Visibility="{Binding ShowAuthorization, Converter={StaticResource VisibleIf}}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Background="Transparent" MouseLeftButtonDown="OnDrag">

                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                    <StackPanel>

                        <TextBlock Text="{DynamicResource Ui.YourdayPartofyourdesktop}" FontSize="30" FontWeight="Light" LineHeight="36"/>
                        <TextBlock Text="{DynamicResource Ui.ConnectGoogleCalendartobringyourscheduleontoyourwallpaper}" Foreground="{DynamicResource Muted}" Margin="0,12,0,18" FontSize="13"/>
                        <StackPanel x:Name="ConnectionForm">
                            <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding IsInitialized}" Value="False"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <Button Content="{DynamicResource Ui.ImportGoogleOAuthfile}" Click="OnImportCredentials" BorderBrush="{DynamicResource Line}" Padding="12,10"/>
                            <TextBlock Text="{Binding CredentialStatus}" Style="{StaticResource Caption}" Margin="2,7,0,14"/>
                            <Button Content="{DynamicResource Ui.ContinuewithGoogle}" Style="{StaticResource PrimaryButton}" Command="{Binding ConnectCommand}" IsEnabled="{Binding HasCredentials}"/>
                            <TextBlock Text="{DynamicResource Ui.ReadonlyaccessYoureventsstayonthisPC}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                            <Expander Header="{DynamicResource Ui.FirsttimeSetupGoogleconnection}" IsExpanded="True">
                                <StackPanel Margin="4,12,0,0">
                                    <TextBlock Text="{DynamicResource Ui.1EnableGoogleCalendarAPIinyourCloudproject}" FontSize="12" Margin="0,0,0,10"/>
                                    <TextBlock Text="{DynamicResource Ui.2InGoogleAuthplatformconfigureconsentandaddyouremailasatestuserCreateaDesktopappclientanddownloaditsJSONfile}" FontSize="12" Margin="0,0,0,10"/>
                                    <TextBlock Text="{DynamicResource Ui.3ImportthatfileabovethencontinuewithGoogleandallowcalendaraccessinyourbrowser}" FontSize="12"/>
                                    <WrapPanel Margin="0,8,0,0"><Button Content="{DynamicResource Ui.OpenGoogleCloud}" Click="OnOpenGoogleCloud" FontSize="11" Foreground="{DynamicResource Accent}"/><Button Content="{DynamicResource Ui.Setupguide}" Click="OnOpenGoogleGuide" FontSize="11" Foreground="{DynamicResource Accent}"/></WrapPanel>
                                </StackPanel>
                            </Expander>
                            <Expander Header="{DynamicResource Ui.EnterOAuthcredentialsmanually}">
                                <StackPanel Margin="0,10,0,0"><TextBlock Text="{DynamicResource Ui.DesktopOAuthclientID}" FontSize="12"/><TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{DynamicResource Ui.DesktopOAuthclientsecret}" FontSize="12"/><TextBox Text="{Binding ClientSecret, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            </Expander>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <ProgressBar Height="2" IsIndeterminate="True" Visibility="{Binding Busy, Converter={StaticResource VisibleIf}}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Visibility="{Binding CanEditGeometry, Converter={StaticResource VisibleIf}}">
            <Thumb Tag="N" Height="6" VerticalAlignment="Top" Margin="14,0" Cursor="SizeNS" DragDelta="OnResize"/>
            <Thumb Tag="S" Height="6" VerticalAlignment="Bottom" Margin="14,0" Cursor="SizeNS" DragDelta="OnResize"/>
            <Thumb Tag="W" Width="6" HorizontalAlignment="Left" Margin="0,14" Cursor="SizeWE" DragDelta="OnResize"/>
            <Thumb Tag="E" Width="6" HorizontalAlignment="Right" Margin="0,14" Cursor="SizeWE" DragDelta="OnResize"/>
            <Thumb Tag="NW" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" DragDelta="OnResize"/>
            <Thumb Tag="NE" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" DragDelta="OnResize"/>
            <Thumb Tag="SW" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" DragDelta="OnResize"/>
        </Grid>
        <Thumb Tag="SE" x:Name="ResizeGrip" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="OnResize" Margin="0,0,8,8" Visibility="{Binding CanEditGeometry, Converter={StaticResource VisibleIf}}" ToolTip="{DynamicResource Ui.Dragtoresize}">
            <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="#01000000"><Path x:Name="GripLines" Data="M 9,18 L 18,9 M 14,18 L 18,14" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.45"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="GripLines" Property="Stroke" Value="{DynamicResource Accent}"/><Setter TargetName="GripLines" Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template>
        </Thumb>
        <Border infrastructure:AppearanceAnimation.Enabled="True" x:Name="EventDetailsOverlay" Background="#99080C10" CornerRadius="{Binding WidgetCornerRadius}" Padding="24" Visibility="{Binding IsEventOpen, Converter={StaticResource VisibleIf}}">
            <Grid>
                <Button Command="{Binding CloseEventCommand}" Background="Transparent" Padding="0" Margin="0" BorderThickness="0" Focusable="False" ToolTip="{DynamicResource Ui.Backtocalendar}">
                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"/></ControlTemplate></Button.Template>
                </Button>
                <Border DataContext="{Binding SelectedEvent}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="18" Padding="22" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Ellipse Width="8" Height="8" Fill="{Binding Color}" Margin="0,0,8,0"/><TextBlock Text="{Binding CalendarName}" Style="{StaticResource Caption}"/></StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="420">
                            <StackPanel>
                                <TextBlock Text="{Binding DateLabel}" FontSize="14" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Time}" FontSize="16" FontWeight="Medium"/>
                                <TextBlock Text="{Binding TimeZoneLabel}" Style="{StaticResource Caption}" Margin="0,5,0,16"/>
                                <StackPanel Visibility="{Binding HasLocation, Converter={StaticResource VisibleIf}}" Margin="0,0,0,16">
                                    <TextBlock Text="{DynamicResource Ui.LOCATION}" Style="{StaticResource Caption}" Margin="0,0,0,6"/><TextBlock Text="{Binding Location}" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding HasDescription, Converter={StaticResource VisibleIf}}">
                                    <TextBlock Text="{DynamicResource Ui.DESCRIPTION}" Style="{StaticResource Caption}" Margin="0,0,0,6"/><controls:LinkTextBlock ContentText="{Binding Description}" FontSize="13" LineHeight="20" TextWrapping="Wrap" Hyperlink.RequestNavigate="OnDescriptionLink"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <Button Grid.Row="2" Content="{DynamicResource Ui.Backtocalendar}" HorizontalAlignment="Right" Command="{Binding DataContext.CloseEventCommand, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{DynamicResource Line}" Margin="0,18,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
