<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Product>Wideska Widget</Product>
    <Description>Desktop widgets for personal planning: calendar and task prioritization.</Description>
    <Version>0.2.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources/Icons/Wideska.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources/Icons/Wideska.ico" />
    <Resource Include="Resources/Icons/Wideska.png" />
  </ItemGroup>
</Project>
