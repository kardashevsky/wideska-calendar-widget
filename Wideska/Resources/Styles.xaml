<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:Wideska.Converters">
    <SolidColorBrush x:Key="Surface" Color="#F2141A1F"/>
    <SolidColorBrush x:Key="Panel" Color="#FF253039"/>
    <SolidColorBrush x:Key="WidgetGlass" Color="#2410181E"/>
    <SolidColorBrush x:Key="Text" Color="#FFF1F5F9"/>
    <SolidColorBrush x:Key="Muted" Color="#FFAFBDC9"/>
    <SolidColorBrush x:Key="Line" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="Accent" Color="#FF8DD3EF"/>
    <SolidColorBrush x:Key="AccentFill" Color="#FF347E9F"/>
    <SolidColorBrush x:Key="TimelineCard" Color="#ED1D2730"/>
    <SolidColorBrush x:Key="TimelineMuted" Color="#BBCAD5"/>
    <SolidColorBrush x:Key="TimelineAxis" Color="#8098ACBA"/>
    <SolidColorBrush x:Key="TimelineGrid" Color="#38BBCAD5"/>
    <SolidColorBrush x:Key="TimelineNow" Color="#F43F5E"/>
    <BooleanToVisibilityConverter x:Key="VisibleIf"/>
    <converters:CompactHeightConverter x:Key="CompactHeight"/>
    <converters:TimelineWidthConverter x:Key="TimelineWidth"/>
    <converters:TimelineHeightConverter x:Key="TimelineHeight"/>
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Panel}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="MaxWidth" Value="340"/>
        <Setter Property="MaxHeight" Value="240"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
            <TextBlock Text="{Binding}" Foreground="{DynamicResource Text}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxWidth="310" MaxHeight="215" FontSize="12"/>
        </DataTemplate></Setter.Value></Setter>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                <ContentPresenter/>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TrayContextMenu" TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="5">
                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TrayMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
            <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="5" Padding="14,9,20,9">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✓" Margin="0,0,7,0" Foreground="{TemplateBinding Foreground}" Visibility="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource VisibleIf}}"/>
                    <TextBlock Text="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}"/>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Panel}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ItemBorder" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="NoWrap" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}" FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </DataTemplate></Setter.Value></Setter>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource Panel}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.4"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource AccentFill}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
        <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="4"/><Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="QuietControls" TargetType="StackPanel">
        <Setter Property="Opacity" Value="0"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Item" Background="{DynamicResource Panel}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
            <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Surface}"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Margin" Value="0,4"/><Setter Property="MinWidth" Value="90"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
            <Grid>
                <ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False" ClickMode="Press">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border CornerRadius="8" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="10,6"><DockPanel><TextBlock Text="⌄" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock Text="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"/></DockPanel></Border></ControlTemplate></ToggleButton.Template>
                </ToggleButton>
                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                    <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="4"><ScrollViewer MaxHeight="320"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border>
                </Popup>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Margin" Value="0,6,0,14"/><Setter Property="Padding" Value="10"/><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="CaretBrush" Value="{DynamicResource Accent}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Margin" Value="0,8"/></Style>
    <Style TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Margin" Value="0,12"/></Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="5"/><Setter Property="Margin" Value="3,0,0,0"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton x:Name="DecreasePage" Command="ScrollBar.PageUpCommand"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource Muted}" CornerRadius="2" Opacity="0.35"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton x:Name="IncreasePage" Command="ScrollBar.PageDownCommand"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
            </Track>
            <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="5"/><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="DecreasePage" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="IncreasePage" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="EventTemplate">
        <Grid Margin="0,4" ToolTip="{Binding Details}">
            <Border Background="{Binding Color}" Opacity="0.13" CornerRadius="10"/>
            <Border BorderBrush="{Binding Color}" BorderThickness="2,0,0,0" Padding="10,8" Margin="0,4">
                <StackPanel><TextBlock Text="{Binding Time}" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,0,0,3"/><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxHeight="38"/></StackPanel>
            </Border>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="CompactEventTemplate">
        <Grid Margin="1,2" ToolTip="{Binding Details}">
            <Border Background="{Binding Color}" Opacity="0.16" CornerRadius="4"/>
            <Border BorderBrush="{Binding Color}" BorderThickness="2,0,0,0" Padding="5,3">
                <TextBlock Text="{Binding Title}" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="MonthDayTemplate">
        <Border x:Name="Cell" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,0.5" Padding="2,3" ClipToBounds="True" ToolTip="{Binding Summary}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Button x:Name="DayNumber" Content="{Binding Number}" Width="24" Height="24" FontSize="12" HorizontalAlignment="Center" Padding="0" Margin="0,0,0,2" BorderThickness="0" Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Date}" ToolTip="{Binding Summary}"/>
                <Ellipse x:Name="EventDot" Width="3" Height="3" Fill="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,1,0,0"/>
                <Grid x:Name="Preview" Grid.Row="1" VerticalAlignment="Top">
                    <ItemsControl ItemsSource="{Binding PreviewEvents}" ItemTemplate="{StaticResource CompactEventTemplate}"/>
                </Grid>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Events.Count}" Value="0"><Setter TargetName="EventDot" Property="Visibility" Value="Collapsed"/></DataTrigger>
            <DataTrigger Binding="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CompactHeight}, ConverterParameter=500}" Value="True">
                <Setter TargetName="Preview" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="Cell" Property="Padding" Value="1,0"/>
                <Setter TargetName="DayNumber" Property="Height" Value="20"/>
                <Setter TargetName="DayNumber" Property="Width" Value="20"/>
                <Setter TargetName="DayNumber" Property="FontSize" Value="11"/>
                <Setter TargetName="DayNumber" Property="Margin" Value="0"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding InMonth}" Value="False"><Setter TargetName="Cell" Property="Opacity" Value="0.27"/></DataTrigger>
            <DataTrigger Binding="{Binding Today}" Value="True"><Setter TargetName="DayNumber" Property="Background" Value="{DynamicResource AccentFill}"/><Setter TargetName="DayNumber" Property="Foreground" Value="White"/><Setter TargetName="DayNumber" Property="FontWeight" Value="SemiBold"/></DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <Style TargetType="Thumb">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="#01000000"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="YearMonthTemplate">
        <Border Margin="1,0" Padding="2,0">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="Medium" FontSize="12" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <UniformGrid Columns="7" Margin="0,0,0,4">
                    <TextBlock Text="M" FontSize="9" HorizontalAlignment="Center"/><TextBlock Text="T" FontSize="9" HorizontalAlignment="Center"/><TextBlock Text="W" FontSize="9" HorizontalAlignment="Center"/><TextBlock Text="T" FontSize="9" HorizontalAlignment="Center"/><TextBlock Text="F" FontSize="9" HorizontalAlignment="Center"/><TextBlock Text="S" FontSize="9" HorizontalAlignment="Center"/><TextBlock Text="S" FontSize="9" HorizontalAlignment="Center"/>
                </UniformGrid>
                <ItemsControl ItemsSource="{Binding Days}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Button x:Name="MiniDay" Content="{Binding Number}" Padding="0,1" Margin="0" FontSize="10" BorderBrush="{DynamicResource Line}" Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Date}" ToolTip="{Binding Summary}"/>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding InMonth}" Value="False"><Setter TargetName="MiniDay" Property="Opacity" Value="0.25"/></DataTrigger>
                            <DataTrigger Binding="{Binding Today}" Value="True"><Setter TargetName="MiniDay" Property="Background" Value="{DynamicResource AccentFill}"/><Setter TargetName="MiniDay" Property="Foreground" Value="White"/></DataTrigger>
                            <DataTrigger Binding="{Binding Events.Count}" Value="0"><Setter TargetName="MiniDay" Property="BorderBrush" Value="Transparent"/></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
